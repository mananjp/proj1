# Dockerfile.frontend — multi-stage: Vite build → Nginx static server
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src

# In containers the frontend talks to the backend through Nginx's /api proxy
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Runtime stage ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# SPA + /api reverse proxy config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Static build output from the previous stage
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/nginx-health || exit 1
