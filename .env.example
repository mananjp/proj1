PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/taskdb
EMAIL_USER=your_email@charusat.edu.in
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=24aiml024@charusat.edu.in
JWT_SECRET=your_super_secret_jwt_key_here

# AI Task Insights (Groq) — backend-only secret, never sent to the browser.
# Create a key at https://console.groq.com/keys
# Leave GROQ_API_KEY empty to fall back to rule-based suggestions.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend build (Vite). In docker-compose this is overridden to /api so
# Nginx proxies requests to the backend container.
VITE_API_URL=http://localhost:5000
